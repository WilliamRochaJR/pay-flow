# Copy this file to .env.production and replace every value before deployment.
# The example credentials are intentionally public and must never be used in AWS.
PAYFLOW_DOMAIN=localhost
APP_PUBLIC_ORIGIN=https://localhost:8443
HTTP_PORT=8088
HTTPS_PORT=8443

POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=change-me-before-deploy

# Base64 example for local validation only. Generate a new secret for production.
JWT_SECRET=Y2hhbmdlLXRoaXMtcGF5Zmxvdy1qd3Qtc2VjcmV0LWJlZm9yZS1kZXBsb3ltZW50
JWT_ISSUER=payflow-api
JWT_ACCESS_TOKEN_TTL=15m

LOG_LEVEL=INFO
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTRATION=5
RATE_LIMIT_TRANSFER=30
RATE_LIMIT_WINDOW=1m
