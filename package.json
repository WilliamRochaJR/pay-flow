{
  "name": "pay-flow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "check:frontend": "npm --prefix frontend run check",
    "check:backend": "cd backend && mvn --batch-mode --no-transfer-progress verify",
    "check": "npm run check:frontend && npm run check:backend",
    "check:e2e": "npm --prefix frontend run test:e2e:local"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
