aws_region           = "us-east-1"
project_name         = "payflow"
environment          = "production"
instance_type        = "t3.micro"
root_volume_size_gib = 20
backup_retention_days = 30

# HTTP is needed for redirect/certificate issuance and HTTPS serves the application.
http_ingress_cidrs = ["0.0.0.0/0"]
