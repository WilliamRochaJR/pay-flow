#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install --yes curl docker.io docker-compose-v2 git unzip

aws_cli_version="2.27.41"
aws_cli_installer="$(mktemp --directory)"
curl --fail --location --silent --show-error \
  "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-$${aws_cli_version}.zip" \
  --output "$${aws_cli_installer}/awscliv2.zip"
unzip -q "$${aws_cli_installer}/awscliv2.zip" -d "$${aws_cli_installer}"
"$${aws_cli_installer}/aws/install"
rm --recursive --force "$${aws_cli_installer}"

systemctl enable --now docker

install --directory --owner=ubuntu --group=ubuntu --mode=0750 /opt/${project_name}
usermod --append --groups docker ubuntu
